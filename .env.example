# ==============================================================================
# Oli AI Agent - Environment Configuration Template
# Duplicate this file as .env and fill in your API key
# ==============================================================================

# AI Provider: "gemini" (recommended, free tier available) or "openai"
AI_PROVIDER=gemini

# Your LLM API Key (Replace with your actual API key)
# Get a free Google Gemini key from: https://aistudio.google.com/
AI_API_KEY=your_api_key_here

# Optional: Custom model name (Defaults: gemini-1.5-flash for Gemini, gpt-4o-mini for OpenAI)
AI_MODEL=gemini-1.5-flash

# Optional: Base URL if using custom OpenAI-compatible endpoint (e.g. Groq, Ollama)
# AI_API_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Server Port
PORT=5000

# Flask Secret Key
SECRET_KEY=oli-agent-secret-key-change-in-production
